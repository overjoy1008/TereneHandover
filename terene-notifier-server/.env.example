# Email account used as sender for SMTP mail
SENDER_EMAIL_USER=name@example.com

# SMTP password or app password for the sender email account
SENDER_EMAIL_PASS=XXXX XXXX XXXX XXXX

# Verified sender phone number for SOLAPI
SENDER_PHONE=02-XXXX-XXXX

# SOLAPI API key (16 Capital/Number)
SOLAPI_API_KEY=YOUR_SOLAPI_API_KEY

# SOLAPI API secret (32 Capital/Number)
SOLAPI_API_SECRET=YOUR_SOLAPI_API_SECRET